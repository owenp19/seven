# =====================================================================
# SEVEN API — PRODUCTION ENVIRONMENT TEMPLATE
# ---------------------------------------------------------------------
# Este archivo ES la "base asentada": la única diferencia entre dev y
# prod se reduce a Rellenar: (1) credenciales Redis/S3, (2) APP_URL y
# (3) comando OPTIMIZE del runbook (línea 30).
#
# Copiar como .env y luego ejecutar el runbook:
#
#   1. php artisan key:generate
#   2. php artisan migrate --force
#   3. php artisan storage:link
#   4. php artisan l5-swagger:generate
#   5. php artisan optimize       (config:cache + route:cache + view:cache)
#   6. php artisan queue:restart  (tras el deploy; workers = redis)
#   7. supervisor: `php artisan queue:work redis --sleep=3 --tries=3`
#
# Rollback del caché de config:  php artisan optimize:clear
# =====================================================================

APP_NAME="SEVEN API"
APP_ENV=production
APP_KEY=                       # ← Rellenar con `php artisan key:generate`
APP_DEBUG=false                # ← requerido en producción
APP_TIMEZONE=America/Bogota
APP_URL=                       # ← Rellenar (ej: https://api.seven.app)

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error                # en prod se recomienda "error"

# ---------------------------------------------------------------------
# DATABASE (MySQL)
# ---------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=seven_db
DB_USERNAME=seven
DB_PASSWORD=                   # ← Rellenar (usuario con mínimo privilegio)

API_PREFIX=v1

# ---------------------------------------------------------------------
# CACHE & QUEUE — Redis (punto 1 de la auditoría escalabilidad)
# ---------------------------------------------------------------------
# Con las variables de abajo la app ya usa Redis para cache (incluye el
# rate limiter), sesiones y colas. Drivers ya definidos en config/*.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null            # ej: .seven.app para cookies cross-subdominio

BROADCAST_CONNECTION=redis
FILESYSTEM_DISK=local          # → "s3" cuando el storage se mueva a S3

QUEUE_CONNECTION=redis         # ← Rellenar credenciales Redis abajo
QUEUE_RETRY_AFTER=90
QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=redis
CACHE_PREFIX=seven.prod.

REDIS_CLIENT=phpredis
REDIS_HOST=                    # ← Rellenar (ej: 127.0.0.1 o el host del cluster)
REDIS_PASSWORD=null            # ← Rellenar si el cluster pide auth
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1               # store de cache separado del de colas
REDIS_QUEUE_DB=2               # conexión "queue" para queue:work

# ---------------------------------------------------------------------
# MAIL
# ---------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=                     # ← Rellenar (ej: email-smtp.us-east-1.amazonaws.com)
MAIL_PORT=587
MAIL_USERNAME=                 # ← Rellenar
MAIL_PASSWORD=                 # ← Rellenar
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@seven.app"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------
# MEDIA — S3 / CDN (punto 4 de la auditoría escalabilidad)
# ---------------------------------------------------------------------
# 1) Subir el contenido local (storage/app/public → bucket) y apuntar
#    FILESYSTEM_DISK=s3. mediaUrl() genera las URLs desde el disco que
#    esté activo (ver también filesystems.disks.public.url).
# 2) Opcional pero recomendado: delante de S3 pon un CDN (CloudFront) y
#    define MEDIA_CDN_URL → mediaUrl() usará esa base de dominio.
# 3) Añadir cabeceras de cache CDN a /storage/*  (no se toca código):
#    CloudFront → Cache policy "Managed-CachingOptimized"; el backend
#    puede forzarlas en nginx con los "expires" de la pseudo-ruta.
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=             # ← Rellenar
AWS_SECRET_ACCESS_KEY=         # ← Rellenar
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=                    # ← Rellenar (ej: seven-media)
AWS_URL=                       # ← Rellenar si el bucket se sirve directo
AWS_ENDPOINT=                  # opcional (MinIO/S3 compatible local)
AWS_USE_PATH_STYLE_ENDPOINT=false
# Los headers de caché de media (expires/EMT) los pone el CDN/nginx
# delante de /storage/* — no entran por .env (ver comentario apartado MEDIA).
MEDIA_CDN_URL=                 # ← Rellenar (ej: https://cdn.seven.app)

# ---------------------------------------------------------------------
# RATE LIMITING por tier (punto 5 de la auditoría escalabilidad)
# ---------------------------------------------------------------------
# Invitados (IP detrás de NAT puede compartir token) y autenticados.
# Ya respaldado por Redis (CACHE_STORE=redis arriba).
# "admin" limita el panel de backoffice (por IP).
API_RATE_LIMIT_GUEST=120
API_RATE_LIMIT_AUTHENTICATED=600
API_RATE_LIMIT_ADMIN=60

# Comentarios por hora y por dispositivo (X-Install-Id), no por IP:
# detrás de una misma red hay varios viajeros legítimos.
API_RATE_LIMIT_COMMENTS=5

# ---------------------------------------------------------------------
# BACKOFFICE — /api/v1/admin/*
# ---------------------------------------------------------------------
# Autenticación individual (Laravel Sanctum): cada administrador se logea
# con email/password en POST /api/v1/admin/auth/login y recibe un token
# personal que se envía como Authorization: Bearer <token>.
# Roles y permisos se siembran con: php artisan db:seed --class=RoleSeeder
# Roles con acceso: SUPER_ADMIN, ADMIN_SEVEN (ADMIN_LOGIN_ROLES).
ADMIN_LOGIN_ROLES=SUPER_ADMIN,ADMIN_SEVEN

# Token compartido LEGACY (X-Admin-Token o Bearer). NO recomendado en
# producción: el sistema aborta con 503 si se activa aquí (fail-secure).
# Debe quedar en false. Si aún lo necesitas para migrar, hazlo en local o
# testing, nunca en este entorno.
ADMIN_API_TOKEN=
ADMIN_LEGACY_TOKEN_ENABLED=false

# Fail-secure: con true la app aborta peticiones HTTP si APP_DEBUG=true o el
# token legacy están activos. No afecta a comandos artisan (migrate/optimize).
SECURITY_ENFORCE_PRODUCTION=true

# Caducidad de los tokens personales de Sanctum, en minutos (30 días).
# Sin valor, los tokens no expiran nunca: se fija aquí por política.
SANCTUM_TOKEN_EXPIRATION=43200

# Media upload: en prod apunta al mismo disco S3 de media
MEDIA_DISK=s3
MEDIA_MAX_KB=5120

# WhatsApp: código de país para los deep-links wa.me (Colombia +57)
WHATSAPP_DEFAULT_COUNTRY=57

# ---------------------------------------------------------------------
# SEARCH (punto 3 de la auditoría escalabilidad)
# ---------------------------------------------------------------------
# Ahora LIKE %q% es suficiente. Cuando el catálogo crezca, migrar a
# MySQL FULLTEXT: crear el índice sobre businesses(name, description)
# y cambiar BusinessRepository::search para usar MATCH...AGAINST.
API_SEARCH_MODE=like           # "like" | "fulltext" (futuro)

VITE_APP_NAME="${APP_NAME}"