APP_NAME="SEVEN API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Bogota
APP_URL=http://127.0.0.1:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=seven_db
DB_USERNAME=root
DB_PASSWORD=

API_PREFIX=v1

# Detalle técnico (stack trace) en las respuestas 5xx. Debe quedar en false
# fuera de localhost: filtra rutas, versiones y datos de queries.
API_DEBUG_TRACE=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

# Límites de rate limiting por tier (invitado / autenticado / admin)
API_RATE_LIMIT_GUEST=120
API_RATE_LIMIT_AUTHENTICATED=600
API_RATE_LIMIT_ADMIN=60

# Comentarios por hora y por dispositivo (tope anti-abuso)
API_RATE_LIMIT_COMMENTS=5

# Modo de búsqueda del catálogo: "like" (actual) | "fulltext" (MySQL, futuro)
API_SEARCH_MODE=like

# ---------------------------------------------------------------------
# Backoffice /api/v1/admin/*
#
# Autenticación individual con Laravel Sanctum:
#   POST /api/v1/admin/auth/login  (email + password -> token personal)
# Las rutas /admin/* exigen un usuario con rol SUPER_ADMIN o ADMIN_SEVEN.
# Roles y permisos se siembran con: php artisan db:seed --class=RoleSeeder
# ---------------------------------------------------------------------

# Token compartido LEGACY (X-Admin-Token o Bearer). DESHABILITADO por
# defecto y, aunque se active, solo se acepta en local/testing: en producción
# la app aborta con 503 (fail-secure). Úsalo solo para migrar integraciones.
ADMIN_API_TOKEN=
ADMIN_LEGACY_TOKEN_ENABLED=false

# Fail-secure de producción: aborta peticiones HTTP si APP_DEBUG=true o el
# token legacy está activo. Déjalo en true; en false solo para tests.
SECURITY_ENFORCE_PRODUCTION=true

# Roles que pueden iniciar sesión en el panel (coma-separados).
ADMIN_LOGIN_ROLES=SUPER_ADMIN,ADMIN_SEVEN

# Caducidad de los tokens personales de Sanctum, en minutos. Vacío = sin
# caducidad. En producción se recomienda 43200 (30 días).
SANCTUM_TOKEN_EXPIRATION=

# Documentación Swagger: en producción responde 404 salvo API_DOCS_ENABLED=true.
API_DOCS_ENABLED=false

# Media upload: disco ("public" en dev con storage:link | "s3" en prod)
MEDIA_DISK=public
MEDIA_MAX_KB=5120

# WhatsApp: código de país para los deep-links wa.me (Colombia +57)
WHATSAPP_DEFAULT_COUNTRY=57

# ---------------------------------------------------------------------
# Asistente turístico de SEVEN (POST /api/v1/assistant/messages)
#
# La IA solo LEE catálogo aprobado a través de herramientas internas: nunca
# toca la base de datos ni recibe credenciales. La API key vive SOLO aquí
# (backend); jamás en el frontend ni en ninguna respuesta.
#
# Proveedor: gemini (Google AI) | fake (determinista, sin red; solo tests).
# ---------------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_TIMEOUT=30
AI_MAX_OUTPUT_TOKENS=1024
AI_TEMPERATURE=0.4

# Límites del orquestador (candidatos/tarjetas/iteraciones/longitud)
AI_MAX_CANDIDATES=15
AI_MAX_RECOMMENDATIONS=3
AI_MAX_TOOL_ITERATIONS=4
AI_MAX_MESSAGE_CHARS=1000

# Persistencia de conversaciones: TTL (horas), tope de mensajes y turnos de
# historial enviados al modelo.
AI_CONVERSATION_TTL_HOURS=24
AI_CONVERSATION_MAX_MESSAGES=40
AI_HISTORY_TURNS=8

# Rate limit del asistente: mensajes por minuto por dispositivo y ráfaga por IP.
AI_RATE_LIMIT_GUEST=20
AI_RATE_LIMIT_AUTHENTICATED=60
AI_RATE_LIMIT_BURST=10

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# CDN delante del storage de media (opcional; mediaUrl() lo usa si está definido)
MEDIA_CDN_URL=

VITE_APP_NAME="${APP_NAME}"
